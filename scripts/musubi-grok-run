#!/bin/sh
# Run only the environment installed by scripts/setup. No implicit pip install
# or fallback to another host's adapter during a Grok session.
set -eu
data="${GROK_PLUGIN_DATA:-${MUSUBI_GROK_PLUGIN_DATA:-$HOME/.local/share/musubi-grok}}"
python="$data/venv/bin/python"
if [ ! -x "$python" ]; then
  echo 'musubi-grok: not set up; run scripts/setup, then restart Grok' >&2
  exit 78
fi
export MUSUBI_HARNESS_BIN="$data/venv/bin/musubi-harness"
export MUSUBI_MEMORY_DATA_BIN="$data/venv/bin/musubi-memory-data"
exec "$python" -m musubi_grok.mcp "$@"
